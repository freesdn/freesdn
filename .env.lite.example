# =============================================================================
# FreeSDN - LITE tier (homelab / a few devices)
# =============================================================================
#   cp .env.lite.example .env.lite   # then fill the secrets below
#   docker compose --env-file .env.lite up -d
#
# Lite = the irreducible core: postgres, logdb, redis, api, ONE worker (all
# queues), scheduler, edge, pg-backup. No worker-io, no flower, no pooling, no
# off-site DR. Small resource limits.

ENVIRONMENT=production
COMPOSE_PROJECT_NAME=freesdn-lite

# ── Profiles: none (core + always-on Caddy edge is all lite needs) ───────────
# (add `cameras` here if you use cameras: COMPOSE_PROFILES=cameras)
COMPOSE_PROFILES=

# ── Secrets - GENERATE THESE: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=__CHANGE_ME__
# Optional auth-only key; keep vault keys unchanged. See docker/TOKEN-REVOCATION-UPGRADING.
JWT_SIGNING_KEY=
# Public HTTPS origin, required only when opting into SLA email notices.
# Example: https://freesdn.example.com (no path/query). Empty keeps delivery unavailable.
FRONTEND_URL=
# Report mail opt-in: generate a UUID4; rotate before restored workers start.
# Keep identical on API/beat/workers; never automatically recover it from a DB backup.
SLA_REPORT_DELIVERY_EPOCH=
ENCRYPTION_SALT=__CHANGE_ME__
POSTGRES_PASSWORD=__CHANGE_ME__
LOGDB_PASSWORD=__CHANGE_ME__
REDIS_PASSWORD=__CHANGE_ME__

# ── One worker handles every queue (no separate worker-io) ───────────────────
WORKER_QUEUES=default,priority,discovery,sync,metrics
CELERY_CONCURRENCY=2
WEB_CONCURRENCY=1

# ── Edge: HTTP on :80 (map to a high host port so no root needed). For local
#    HTTPS set CADDY_SITE_ADDRESS=localhost; for a domain set it to that domain.
CADDY_SITE_ADDRESS=:80
EDGE_HTTP_PORT=8080
EDGE_HTTPS_PORT=8443

# ── Small footprint ──────────────────────────────────────────────────────────
POSTGRES_MEM_LIMIT=1G
LOGDB_MEM_LIMIT=1G
REDIS_MEM_LIMIT=256M
# Leave room for native allocations and persistence copy-on-write. Existing
# installs must add this setting (or size their own config) before upgrading.
REDIS_CONFIG_PATH=./docker/redis/redis-lite.conf
API_MEM_LIMIT=768M
WORKER_MEM_LIMIT=768M
SCHEDULER_MEM_LIMIT=256M
EDGE_MEM_LIMIT=256M
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=10

# ── Backups: set a GPG key pair for encrypted local dumps (same as pro/max).
#    Keep the PRIVATE key off this host for restore. If you have no GPG key and
#    understand the risk of unencrypted backups on a local-only host, uncomment
#    BACKUP_ALLOW_PLAINTEXT=1 below - pg-backup will refuse to run without one
#    of these two settings.
# WARNING: backups are DISABLED until the key below actually exists. The repo
# ships no ./secrets/backup-public.asc, so on a fresh install pg-backup refuses
# to write (correctly -- it will not emit plaintext dumps) and simply idles. It
# says so only in its own container log, so ADD `metrics` to COMPOSE_PROFILES:
# the freesdn_pg_backup_config_valid alert is what tells you, and it fires
# before the first successful backup. Export the public key to the path below.
BACKUP_GPG_RECIPIENT=__CHANGE_ME_OR_UNCOMMENT_PLAINTEXT_BELOW__
BACKUP_GPG_PUBLIC_KEY_PATH=./secrets/backup-public.asc
# LOCAL-ONLY explicit opt-out: removes GPG requirement for homelab hosts where
# backup volume access is physically controlled. Remove if you set GPG above.
# BACKUP_ALLOW_PLAINTEXT=1

# ── Cameras? set COMPOSE_PROFILES=cameras above.

# Distinct subnet → multiple tiers/instances can coexist on one host.
NETWORK_SUBNET=172.28.0.0/16
FORWARDED_ALLOW_IPS=172.28.0.0/16

# ── Device writes ────────────────────────────────────────────────────────────
# FreeSDN manages your gear out of the box, so the shipped default is
# read-WRITE. Writes are still gated per request (an explicit force, plus a
# confirm on deletes). Set this to true for a monitor-only deployment, or while
# first pointing FreeSDN at production hardware you have not yet vetted.
ADAPTER_READ_ONLY=false
