# Docker
# -----------------------------------------------------------------------------

docker-compose.override.yml
docker-compose.local.yml
# Generated compose artifact — may embed concrete local secrets. Never commit it.
composed.yml
.docker/

# SSL certificates and Let's Encrypt state (generated, never commit)
docker/ssl/*
!docker/ssl/.gitkeep
docker/certbot/

