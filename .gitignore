build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
!frontend/src/lib/
!frontend/src/lib/**
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Virtual environments
venv/
.venv/
env/
ENV/
.env/
backend/venv/
backend/.venv/
.python-version

# pip
