.vercel

# Storybook
storybook-static/

# -----------------------------------------------------------------------------
# IDE / Editor
# -----------------------------------------------------------------------------

.idea/
*.swp
*.swo
*~
.project
.classpath
.settings/
*.sublime-workspace
*.sublime-project

# VS Code - ignore everything except recommended extensions
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json

# -----------------------------------------------------------------------------
# Environment & Secrets (CRITICAL - NEVER COMMIT)
# -----------------------------------------------------------------------------

.env
.env.*
!.env.example
!.env.sample
# Committed tier presets (knobs only, placeholder secrets). The real
# .env.lite / .env.pro / .env.max / .env.dev (with secrets) stay ignored.
!.env.*.example
*.env
.env.local
.env.*.local
backend/.env
backend/.env.*
!backend/.env.example
frontend/.env
frontend/.env.*
!frontend/.env.example

# API Keys & Tokens (patterns)
**/api_key*
**/apikey*
**/*.secret
**/*_secret.*
**/secret.json
**/secret.yaml
**/secret.yml
!**/*.example
!**/secret.example

# Allow source code files that match the above patterns
!backend/app/models/api_keys.py
!backend/app/api/v1/endpoints/api_keys.py
!frontend/src/pages/settings/APIKeysTab.tsx

# Private Keys & Certificates
*.pem
*.key
*.crt
*.p12
*.pfx
*.jks
*.keystore
*.cer
id_rsa*
id_ed25519*
*.ppk

# Secrets directories (anchored to v2 root only).
#
# ``secrets/`` is kept in version control as a mount point for the
# pg-backup container's GPG public key - only README.md / .gitkeep /
# .gitignore inside it are tracked; everything else (including
# operator-supplied public/private keys) is ignored by the inner
# ``secrets/.gitignore``.
secrets/*
!secrets/README.md
!secrets/.gitkeep
!secrets/.gitignore
/private/
/credentials/
/.secrets/

