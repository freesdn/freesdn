{
  "telegraf": {
    "method": "get_telegraf_status",
    "wire": {
      "/api/telegraf/general/get": {
        "general": {
          "enabled": "1"
        }
      },
      "/api/telegraf/output/get": {
        "output": {
          "influx_enable": "1",
          "graphite_enable": "0",
          "prometheus_enable": "0",
          "influx_url": "https://owned-metrics.example.test",
          "influx_database": "owned",
          "influx_v2_enable": "0"
        }
      },
      "/api/telegraf/service/status": {
        "status": "running"
      }
    },
    "expected": {
      "enabled": true,
      "running": true,
      "output_influxdb": true,
      "influx_url": "https://owned-metrics.example.test"
    }
  },
