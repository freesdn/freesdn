# =============================================================================
# FreeSDN - DEV (developer workflow: hot-reload, Vite, exposed ports)
# =============================================================================
#   cp .env.dev.example .env.dev
#   docker compose -f docker-compose.yml -f docker-compose.dev.yml --env-file .env.dev up -d
#
# Frontend is the Vite dev server (HMR) on :5173 (proxies /api). Backend runs
# the dev image with the source bind-mounted + uvicorn --reload. DB/Redis/API
# ports are exposed for local tooling. ENVIRONMENT=development auto-generates
# any missing secrets, so the weak values below are fine for local use.

ENVIRONMENT=development
COMPOSE_PROJECT_NAME=freesdn-dev
BACKEND_TARGET=development

# Cameras in dev? COMPOSE_PROFILES=cameras  (the Vite frontend runs regardless).
COMPOSE_PROFILES=

# ── Dev secrets (placeholders; weak is OK locally, do NOT use in production) ──
# Replace each __CHANGE_ME__ with any local value. They only need to be
# internally consistent for a throwaway dev stack; never reuse in production.
SECRET_KEY=__CHANGE_ME__
# Optional auth-only key; keep vault keys unchanged. See docker/TOKEN-REVOCATION-UPGRADING.
JWT_SIGNING_KEY=
# Public HTTPS origin, required only when opting into SLA email notices.
# Example: https://freesdn.example.com (no path/query). Empty keeps delivery unavailable.
FRONTEND_URL=
# Report mail opt-in: generate a UUID4; rotate before restored workers start.
# Keep identical on API/beat/workers; never automatically recover it from a DB backup.
SLA_REPORT_DELIVERY_EPOCH=
ENCRYPTION_SALT=__CHANGE_ME__
POSTGRES_PASSWORD=__CHANGE_ME__
LOGDB_PASSWORD=__CHANGE_ME__
REDIS_PASSWORD=__CHANGE_ME__

# ── Concurrency / pool ───────────────────────────────────────────────────────
CELERY_CONCURRENCY=4
WEB_CONCURRENCY=1

# ── Exposed host ports (dev only) ────────────────────────────────────────────
API_HOST_PORT=8000
FRONTEND_HOST_PORT=5173
POSTGRES_HOST_PORT=15432
LOGDB_HOST_PORT=15433
REDIS_HOST_PORT=16379

# Dev backups are unencrypted (handled by the dev overlay).

# Distinct subnet → multiple tiers/instances can coexist on one host.
NETWORK_SUBNET=172.31.0.0/16
FORWARDED_ALLOW_IPS=172.31.0.0/16
