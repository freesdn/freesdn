# =============================================================================
# FreeSDN - MAX tier (enterprise / multi-site, HA)
# =============================================================================
#   cp .env.max.example .env.max   # fill secrets, domain, offsite, repl creds
#   docker compose --env-file .env.max up -d
#   # For the replication/Sentinel failover topology, add the HA overlay:
#   docker compose --env-file .env.max -f docker-compose.yml -f docker-compose.ha.yml up -d
#
# Max = everything: full async split, Flower, PgBouncer pooling, off-site DR,
# large resources. The HA overlay adds a Postgres streaming replica, a 3-node
# Redis Sentinel quorum, a 2nd API replica, and an nginx round-robin LB.

ENVIRONMENT=production
COMPOSE_PROJECT_NAME=freesdn-max

# ── Profiles: io-worker + monitoring + pooling + dr (Caddy edge is always on) ─
COMPOSE_PROFILES=io-worker,monitoring,pooling,dr

# ── Secrets - GENERATE: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=__CHANGE_ME__
ENCRYPTION_SALT=__CHANGE_ME__
POSTGRES_PASSWORD=__CHANGE_ME__
LOGDB_PASSWORD=__CHANGE_ME__
REDIS_PASSWORD=__CHANGE_ME__
FLOWER_BASIC_AUTH=admin:__CHANGE_ME__
# Replication credentials (HA overlay only)
POSTGRES_REPL_USER=repl
POSTGRES_REPL_PASSWORD=__CHANGE_ME__

# ── Async split, higher concurrency ──────────────────────────────────────────
WORKER_QUEUES=default,priority
WORKER_IO_QUEUES=discovery,sync,metrics
CELERY_CONCURRENCY=8
CELERY_IO_CONCURRENCY=4
WEB_CONCURRENCY=4

# ── Route the app through PgBouncer (pooling profile) ────────────────────────
DB_HOST=pgbouncer
DB_PORT=6432
LOGDB_HOST=pgbouncer-logdb
LOGDB_PORT=6432
DB_POOL_SIZE=40
DB_MAX_OVERFLOW=60

# ── Edge ─────────────────────────────────────────────────────────────────────
CADDY_SITE_ADDRESS=freesdn.example.com
CADDY_ACME_EMAIL=admin@example.com
EDGE_HTTP_PORT=80
EDGE_HTTPS_PORT=443

# ── Cross-origin REST (OPTIONAL): the SPA is same-origin behind the edge, so the
#    UI + realtime WebSockets work without this. Only set it if a separate
#    frontend origin calls this API cross-origin (https:// required in prod).
# CORS_ORIGINS=["https://freesdn.example.com"]
# ── Metrics (CAN-019): /metrics is internal-only (no host port). Fail-closed in
#    production - WITHOUT a token it is NOT served. Set METRICS_AUTH_TOKEN + a
#    matching Prometheus bearer_token_file to enable authenticated scraping.
# METRICS_AUTH_TOKEN=__CHANGE_ME__   # openssl rand -hex 32

# ── Plugin marketplace: sync requires a signed catalog. Pin the publisher's
#    Ed25519 PUBLIC key here; the catalog must carry a detached signature from
#    the matching private key. Without it /marketplace/sync refuses; for a
#    trusted private registry set MARKETPLACE_ALLOW_UNSIGNED=1 instead.
# MARKETPLACE_PUBLISHER_PUBLIC_KEY=__CHANGE_ME__   # hex Ed25519 public key
# MARKETPLACE_ALLOW_UNSIGNED=0

# ── Resources (large) ────────────────────────────────────────────────────────
POSTGRES_MEM_LIMIT=4G
POSTGRES_CPU_LIMIT=4.0
LOGDB_MEM_LIMIT=4G
REDIS_MEM_LIMIT=1G
# SIZING (battle-tested): ~300-375MB per gunicorn worker. 2G fits WEB_CONCURRENCY=4
# (verified: ~1.5G under load, no OOM). Keep API_MEM_LIMIT >= WEB_CONCURRENCY*0.375G
# + 0.25G headroom when scaling either up.
API_MEM_LIMIT=2G
WORKER_MEM_LIMIT=2G
WORKER_IO_MEM_LIMIT=2G

# ── Backups: GPG encryption (required) + off-site sync ───────────────────────
BACKUP_GPG_RECIPIENT=backup@example.com
BACKUP_GPG_PUBLIC_KEY_PATH=./secrets/backup-public.asc
BACKUP_OFFSITE_REMOTE=backupremote
BACKUP_OFFSITE_PATH=freesdn-backups
BACKUP_OFFSITE_CONFIG_PATH=./secrets/rclone.conf
BACKUP_OFFSITE_RETENTION_DAYS=30

# Distinct subnet → multiple tiers/instances can coexist on one host.
NETWORK_SUBNET=172.30.0.0/16
FORWARDED_ALLOW_IPS=172.30.0.0/16
