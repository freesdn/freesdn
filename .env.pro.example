# =============================================================================
# FreeSDN - PRO tier (SMB / dozens-hundreds of devices)
# =============================================================================
#   cp .env.pro.example .env.pro   # then fill secrets + domain
#   docker compose --env-file .env.pro up -d
#
# Pro = the full async split (worker + worker-io + scheduler + flower) and the
# Caddy edge with automatic Let's Encrypt. Pooling + off-site DR are one toggle
# away (add `pooling`,`dr` to COMPOSE_PROFILES).

ENVIRONMENT=production
COMPOSE_PROJECT_NAME=freesdn-pro

# ── Profiles: dedicated I/O worker + Flower dashboard (Caddy edge is always on)
COMPOSE_PROFILES=io-worker,monitoring,metrics

# ── Secrets - GENERATE: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=__CHANGE_ME__
# Optional auth-only key; keep vault keys unchanged. See docker/TOKEN-REVOCATION-UPGRADING.
JWT_SIGNING_KEY=
# Public HTTPS origin, required only when opting into SLA email notices.
# Example: https://freesdn.example.com (no path/query). Empty keeps delivery unavailable.
FRONTEND_URL=
# Report mail opt-in: generate a UUID4; rotate before restored workers start.
# Keep identical on API/beat/workers; never automatically recover it from a DB backup.
SLA_REPORT_DELIVERY_EPOCH=
ENCRYPTION_SALT=__CHANGE_ME__
POSTGRES_PASSWORD=__CHANGE_ME__
LOGDB_PASSWORD=__CHANGE_ME__
REDIS_PASSWORD=__CHANGE_ME__
FLOWER_BASIC_AUTH=admin:__CHANGE_ME__

# ── Async split: quick lane vs I/O lane ──────────────────────────────────────
WORKER_QUEUES=default,priority
WORKER_IO_QUEUES=discovery,sync,metrics
CELERY_CONCURRENCY=4
CELERY_IO_CONCURRENCY=2
WEB_CONCURRENCY=2

# ── Edge: set to your domain for automatic HTTPS (needs ports 80+443 + DNS).
#    Behind an upstream LB? use CADDY_SITE_ADDRESS=:80 and terminate TLS there.
CADDY_SITE_ADDRESS=freesdn.example.com
CADDY_ACME_EMAIL=admin@example.com
EDGE_HTTP_PORT=80
EDGE_HTTPS_PORT=443

# ── Cross-origin REST (OPTIONAL). The SPA is served by the Caddy edge on the
#    SAME origin as the API, so the UI + realtime WebSockets work WITHOUT this
#    (same-origin WS is always allowed). Only set CORS_ORIGINS if a SEPARATE
#    frontend origin calls this API cross-origin. Must be https:// in production;
#    localhost is stripped in prod. Match your CADDY_SITE_ADDRESS domain.
# CORS_ORIGINS=["https://freesdn.example.com"]

# ── Metrics (CAN-019): /metrics is INTERNAL-only (no host port, not on the edge)
#    and in production is served only to this bearer token. install.sh generates
#    it; the bundled Prometheus (`metrics` profile) reads the same value, so its
#    freesdn-api target and the API alert rules work out of the box. Leave it
#    set even if you scrape with your own Prometheus (use it as the bearer).
METRICS_AUTH_TOKEN=__CHANGE_ME__

# ── Plugin marketplace: catalog sync requires a signed catalog. Pin the
#    publisher's Ed25519 PUBLIC key here; the catalog must carry a detached
#    signature from the matching private key. Without a pinned key
#    /marketplace/sync refuses (secure-by-default). For a fully-trusted
#    private/dev registry set MARKETPLACE_ALLOW_UNSIGNED=1 instead.
# MARKETPLACE_PUBLISHER_PUBLIC_KEY=__CHANGE_ME__   # hex Ed25519 public key
# MARKETPLACE_ALLOW_UNSIGNED=0

# ── Resources (moderate) ─────────────────────────────────────────────────────
POSTGRES_MEM_LIMIT=2G
LOGDB_MEM_LIMIT=2G
# Same Valkey limit as Max. At 768M a persistence fork under pressure was
# OOM-killed in 5 of ~20 hosted runs; Max at 1G never was.
REDIS_MEM_LIMIT=1G
# SIZING (battle-tested): ~300-375MB per gunicorn worker. With WEB_CONCURRENCY=2,
# 1G is comfortable. If you raise WEB_CONCURRENCY, raise this in step
# (>= WEB_CONCURRENCY*0.375G + 0.25G) or workers OOM-churn under load.
API_MEM_LIMIT=1G
WORKER_MEM_LIMIT=1G
WORKER_IO_MEM_LIMIT=1G
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=30

# ── Backups: configure GPG encryption (a fresh key pair; keep the PRIVATE key
#    off this host for restore). pg-backup fail-closes without this in prod.
# WARNING: database backups are OFF until a public key is in the file below.
# No install ships one, and pg-backup refuses to write plaintext dumps, so it
# idles and FreeSDN shows "Database backups: OFF" on the Backups page (and raises
# an alert) until you add one. The installer pre-creates the file empty so Docker
# cannot turn the path into a directory. To create a key pair, run
#   ./scripts/backup-keygen.sh > /somewhere/off/this/host/freesdn-backup-private.asc
# It installs the PUBLIC key here and hands you the PRIVATE key once; pg-backup
# re-checks every 60s, so no restart is needed. Keep the private key OFF this host:
# it is the only way to restore. Leave BACKUP_GPG_RECIPIENT empty to encrypt to the
# single key in the file, or set it to a fingerprint / e-mail in that file.
BACKUP_GPG_RECIPIENT=
BACKUP_GPG_PUBLIC_KEY_PATH=./secrets/backup-public.asc

# ── Optional: connection pooling + off-site DR - append to COMPOSE_PROFILES:
#    COMPOSE_PROFILES=io-worker,monitoring,pooling,dr
#    (pooling also needs: DB_HOST=pgbouncer DB_PORT=6432 LOGDB_HOST=pgbouncer-logdb LOGDB_PORT=6432)

# Distinct subnet → multiple tiers/instances can coexist on one host.
NETWORK_SUBNET=172.29.0.0/16
FORWARDED_ALLOW_IPS=172.29.0.0/16

# ── Device writes ────────────────────────────────────────────────────────────
# FreeSDN manages your gear out of the box, so the shipped default is
# read-WRITE. Writes are still gated per request (an explicit force, plus a
# confirm on deletes). Set this to true for a monitor-only deployment, or while
# first pointing FreeSDN at production hardware you have not yet vetted.
ADAPTER_READ_ONLY=false

# Local backup storage locations must sit under /data/backups (the backup_data
# volume). To allow other folders on this server, for example a NAS mounted on
# the host, list them here as comma-separated absolute paths and mount each one
# into the api, worker and worker-io containers. Only this setting can widen
# the list; the web UI and API cannot.
# BACKUP_LOCAL_EXTRA_ROOTS=/mnt/nas-backups,/srv/freesdn-backups

# Webhook receivers on your own network (n8n, Node-RED, Home Assistant) must be
# listed here, as comma-separated host names or addresses, before FreeSDN will
# deliver to them. Loopback, link-local and cloud metadata addresses stay
# unreachable whatever is listed.
# WEBHOOK_ALLOWED_HOSTS=n8n.lan,10.0.0.50

# FreeSDN starts tailscaled with --no-logs-no-support, so it sends no
# diagnostic logs to Tailscale Inc. (log.tailscale.com); Tailscale's support
# then cannot see this node's logs. Set false to allow the upload. Applies to
# the tailscale container, the optional privileged vpn container and the
# optional Tailscale access addon (docker-compose.tailscale.yml).
# TAILSCALE_NO_LOGS_NO_SUPPORT=false

# Days of platform event history and webhook delivery records (the delivery
# log and the dead-letter queue) to keep, 1 to 36500. Older rows are deleted
# once a day.
# EVENT_RETENTION_DAYS=30

# Minimum time between full gateway syncs (rules, NAT, VPN, interfaces, leases),
# in seconds, 300 to 86400. A gateway's own sync interval is used when longer.
# The 2-minute health poll covers reachability in between.
# GATEWAY_SYNC_MIN_INTERVAL_SECONDS=1800
