# CRITICAL: this file MUST exist for `npm run build:demo` to isolate the demo.
# Vite loads .env.{mode} when --mode is passed, baking VITE_DEMO_MODE=true into
# the static bundle at build time. Without it, demo mocking would not activate
# and the build could attempt real same-origin /api/v1 + websocket calls.
# (src/demo/mode.ts also falls back to MODE === 'demo' as a second guard.)
VITE_DEMO_MODE=true
