# =============================================================================
# FreeSDN v2 Frontend - React/Vite Git Ignore
# =============================================================================

# Dependencies
node_modules/
.pnp/
.pnp.js

# Build outputs
dist/
build/
.next/
out/
storybook-static/

# Debug logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
lerna-debug.log*

# Runtime data
pids
*.pid
*.seed
*.pid.lock

# TypeScript
*.tsbuildinfo
next-env.d.ts

# Testing
coverage/
.nyc_output/
test-results/
playwright-report/
playwright/.cache/
# NOTE: tests/visual/__snapshots__/ IS intentionally committed - it's the
# visual baseline that PR diffs are compared against. Only the report/results
# directories above are ignored.

# Cache
.npm
.eslintcache
.stylelintcache
.parcel-cache/
.turbo
.vite/

# Vite
*.local

# Auto-generated by vite.config.ts
src/lib/build-info.ts

# Environment
.env
.env.*
!.env.example
# .env.demo is a PUBLIC build config -- VITE_DEMO_MODE=true and nothing else --
# and `npm run build:demo` fails without it, because verify-demo-build.mjs
# checks for it. It survives in this repo only because it was tracked before the
# rule above existed; git applies ignore rules to UNTRACKED files only. The
# flatten does `git init` + `git add -A` in a fresh worktree, where it IS
# untracked, so `.env.*` silently dropped it and every public clone has been
# unable to run build:demo for three releases. release.py's env-hygiene check
# already whitelists this file by name as a benign public build config.
!.env.demo

# IDE
.idea/
.vscode/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Misc
*.log
