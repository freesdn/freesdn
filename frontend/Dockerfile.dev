# FreeSDN - Frontend Development Dockerfile
# Alpine development environment; production serves compiled assets with Caddy.
# Node.js 24 LTS + Vite 8.x + React 19

# Release policy: stay on Node 24 LTS; qualify LTS major migrations explicitly.
FROM node:24.21.0-alpine3.24

RUN npm install -g npm@12.2.0

# Refresh security patches; keep git for dependencies fetched from repositories.
RUN apk upgrade --no-cache && apk add --no-cache git

WORKDIR /app

# Prevent tsc OOM inside container (305k LOC codebase)
ENV NODE_OPTIONS="--max-old-space-size=4096"

# Install dependencies first (caching)
# --legacy-peer-deps because openapi-typescript@7.x's peer is still
# pinned at typescript@^5.x while the project tracks typescript@^6.
# Drop the flag once openapi-typescript ships a TS6-compatible peer.
# (.npmrc carries the same flag - copied so local/CI/Docker stay consistent.)
COPY package*.json .npmrc* ./
# Bind the dependency volume to the lock, npm config and actual native runtime.
COPY docker-entrypoint.dev.sh /usr/local/bin/
RUN sed -i 's/\r$//' /usr/local/bin/docker-entrypoint.dev.sh && \
    chmod +x /usr/local/bin/docker-entrypoint.dev.sh && \
    docker-entrypoint.dev.sh true

# Copy source after the locked dependency layer.
COPY . .

EXPOSE 5173

ENTRYPOINT ["docker-entrypoint.dev.sh"]
CMD ["npm", "run", "dev", "--", "--host", "0.0.0.0"]
