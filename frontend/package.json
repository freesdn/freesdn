    "brace-expansion": ">=5.0.6",
    "js-yaml": ">=4.2.0 <5"
  },
  "engines": {
    "node": ">=24.0.0",
    "npm": ">=11.0.0"
  },
  "dependencyHolds": {
    "_comment": "Majors deliberately NOT taken, with the reason. Mirrors how backend/pyproject.toml records its redis/kombu ceiling. Re-check these when the stated blocker clears.",
    "typescript": "Held at 6.x. 7.0 is BLOCKED BY THE ECOSYSTEM, not by our code: tsc --noEmit passes clean on 7.0, but typescript-eslint refuses to load against it ('typescript-eslint does not support TS 7.0') and tracks support for >=7.1 in typescript-eslint#10940. The lint gate cannot run, so the upgrade is not adoptable yet. Verified 2026-08-20.",
    "@tanstack/react-table": "Held at 8.x. 9.0 is a genuine API rewrite -- useReactTable -> ReactTable, getCoreRowModel -> createCoreRowModel, ColumnDef arity 2-3 -- across the canonical DataTable that 69 pages render through. No CVE motivates it (npm audit: 0). Held because the three row models it renames (sorting, pagination, filtering) have NO test coverage: data-table.test.tsx covers rendering, empty state, selection, custom cells, loading and row-click only. A type-clean migration could pass every test and still break sorting on 69 pages. Take this on only alongside tests for sort/paginate/search. Verified 2026-08-20."
  }
}
