{
  "name": "freesdn-frontend",
  "private": true,
  "version": "26.08.2",
  "description": "FreeSDN Unified Network Management Platform, React Frontend",
  "license": "AGPL-3.0-only",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:demo": "vite build --mode demo && node scripts/verify-demo-build.mjs",
    "build:strict": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx,css,json}\"",
    "type-check": "node scripts/gen-build-info.mjs && tsc --noEmit",
    "i18n:check": "node scripts/i18n-extract.cjs",
    "i18n:verify": "node scripts/i18n-verify.cjs",
    "test": "vitest run",
    "test:run": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "storybook": "storybook dev -p 6006 --no-open",
    "build-storybook": "storybook build",
    "test:visual": "playwright test --config=playwright.config.ts",
    "test:visual:update": "playwright test --config=playwright.config.ts --update-snapshots",
    "audit": "npm audit --audit-level=moderate",
    "audit:fix": "npm audit fix",
    "gen:openapi": "python ../backend/scripts/export_openapi.py --output openapi.json",
    "gen:api-types": "openapi-typescript ./openapi.json -o src/lib/api/generated/openapi.d.ts",
    "gen:api-check": "openapi-typescript ./openapi.json -o src/lib/api/generated/openapi.d.ts --check",
    "gen:api": "npm run gen:openapi && npm run gen:api-types"
  },
