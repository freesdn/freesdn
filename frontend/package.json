{
  "name": "freesdn-frontend",
  "private": true,
  "version": "26.10.2",
  "description": "FreeSDN Unified Network Management Platform, React Frontend",
  "license": "AGPL-3.0-only",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/gen-build-info.mjs && vite build && node scripts/check-build-budget.mjs",
    "build:demo": "node scripts/gen-build-info.mjs && vite build --mode demo && node scripts/verify-demo-build.mjs && node scripts/check-build-budget.mjs",
    "build:strict": "node scripts/gen-build-info.mjs && tsc -b && vite build && node scripts/check-build-budget.mjs",
    "preview": "vite preview",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx,css,json}\"",
    "type-check": "node scripts/gen-build-info.mjs && tsc --noEmit",
    "i18n:check": "node scripts/i18n-extract.cjs",
    "i18n:verify": "node scripts/i18n-verify.cjs",
    "test": "vitest run",
    "test:run": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "storybook": "storybook dev -p 6006 --no-open",
    "build-storybook": "storybook build",
    "test:visual": "playwright test --config=playwright.config.ts",
    "test:visual:update": "playwright test --config=playwright.config.ts --update-snapshots",
    "audit": "npm audit --audit-level=moderate",
    "audit:fix": "npm audit fix",
    "gen:openapi": "python ../backend/scripts/export_openapi.py --output openapi.json",
    "gen:api-types": "openapi-typescript ./openapi.json -o src/lib/api/generated/openapi.d.ts",
    "gen:api-check": "openapi-typescript ./openapi.json -o src/lib/api/generated/openapi.d.ts --check",
    "gen:api": "npm run gen:openapi && npm run gen:api-types"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@hookform/resolvers": "^5.9.1",
    "@radix-ui/react-accordion": "^1.2.20",
    "@radix-ui/react-alert-dialog": "^1.1.23",
    "@radix-ui/react-avatar": "^1.2.6",
    "@radix-ui/react-checkbox": "^1.3.11",
    "@radix-ui/react-collapsible": "^1.1.20",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-progress": "^1.1.16",
    "@radix-ui/react-scroll-area": "^1.2.18",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-separator": "^1.1.15",
    "@radix-ui/react-slider": "^1.4.7",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-switch": "^1.3.7",
    "@radix-ui/react-tabs": "^1.1.21",
    "@radix-ui/react-toast": "^1.2.23",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@tanstack/react-query": "^5.104.1",
    "@tanstack/react-table": "^9.2.4",
    "@tanstack/react-virtual": "^3.14.13",
    "@xyflow/react": "^12.12.0",
    "axios": "^1.20.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "framer-motion": "^14.0.0",
    "hls.js": "^1.7.3",
    "html-to-image": "^1.11.13",
    "i18next": "^26.4.2",
    "i18next-browser-languagedetector": "^8.2.1",
    "i18next-http-backend": "^4.0.2",
    "immer": "^11.1.21",
    "lucide-react": "^1.51.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-hook-form": "^7.89.0",
    "react-i18next": "^17.0.15",
    "react-is": "^19.3.0",
    "react-router-dom": "^7.18.4",
    "recharts": "^3.10.1",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.5",
    "zustand": "^5.0.15",
    "@noble/hashes": "2.4.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@storybook/addon-themes": "^10.6.1",
    "@storybook/react-vite": "^10.6.1",
    "storybook": "^10.6.3",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^24.19.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^5.0.3",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "happy-dom": "^20.14.5",
    "http-server": "^14.1.1",
    "openapi-typescript": "^7.13.0",
    "prettier": "^3.9.9",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  },
  "overrides": {
    "source-map-js": ">=1.2.2 <2",
    "minimatch": ">=10.2.3",
    "rollup": ">=4.59.0",
    "follow-redirects": ">=1.16.0",
    "ws": ">=8.20.1",
    "brace-expansion": ">=5.0.6",
    "js-yaml": ">=4.3.2 <5",
    "qs": ">=6.16.0 <7"
  },
  "engines": {
    "node": ">=24.21.0 <25",
    "npm": ">=12.2.0 <13"
  },
  "dependencyHolds": {
    "_comment": "Majors deliberately NOT taken, with the reason. Mirrors how backend/pyproject.toml records its redis/kombu ceiling. Re-check these when the stated blocker clears.",
    "typescript": "TypeScript 7.0.2 is current, but typescript-eslint 8.71.0 explicitly supports >=4.8.4 <6.1.0. Retain the supported 6.0 line until the parser and lint ecosystem support 7.x. Registry metadata rechecked 2026-10-04. openapi-typescript also still declares a ^5.x peer; existing legacy-peer-deps remains necessary.",
    "@types/node": "Track Node 24 LTS APIs to match the public-release Docker builder and CI. Adopt a newer major only after it enters LTS and FreeSDN qualifies that migration."
  },
  "packageManager": "npm@12.2.0"
}
