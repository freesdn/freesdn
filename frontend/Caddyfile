# FreeSDN - universal edge (Caddy). One file replaces the nginx http-only/ssl
# templates + certbot + the cert scripts. TLS is automatic and driven entirely
# by CADDY_SITE_ADDRESS:
#
#   :80                      → plain HTTP  (default; behind an upstream LB, or local)
#   localhost / 127.0.0.1    → HTTPS via Caddy's INTERNAL CA  (homelab, no domain)
#   freesdn.example.com      → HTTPS via Let's Encrypt, auto-obtained + renewed (SMB/pro)
#
# No other change is needed to switch modes - Caddy provisions/renews certs itself.

{
	admin off
	email {$CADDY_ACME_EMAIL:admin@example.com}
}

{$CADDY_SITE_ADDRESS::80} {
	encode zstd gzip

	# Cap request bodies (matches the old nginx client_max_body_size 50m).
	request_body {
		max_size 50MB
	}

	# Transport/info headers that are universally safe on EVERY response,
	# including /api. HSTS is ignored by browsers over plain HTTP, so it is safe
	# to send in every mode. The framing + CSP headers are NOT set here on
	# purpose - they would override (and weaken) the API middleware's own
	# stronger per-response headers (X-Frame-Options: DENY + a CSP with
	# frame-ancestors 'none'/base-uri/form-action). Those are applied only to the
	# SPA handle below, so /api JSON keeps the app's hardened headers untouched.
	header {
		Strict-Transport-Security "max-age=63072000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
		-Server
	}

	# Edge liveness only; /health and /health/* belong to the SPA dashboard.
	handle /healthz {
		respond "healthy" 200
	}

	# API + WebSocket + streams. reverse_proxy auto-detects the WebSocket
	# Upgrade handshake; flush_interval -1 disables response buffering so
	# camera MSE/MJPEG and SSE streams (which ride through /api) flow in
	# real time instead of being buffered. NO framing/CSP header override here -
	# the app sets its own (stricter) ones per response.
	handle /api* {
		reverse_proxy {$API_UPSTREAM:api:8000} {
			flush_interval -1
		}
	}

	# Single-page app: long-cache the fingerprinted assets, fall back to
	# Fingerprinted build assets. These MUST 404 when absent, so they are served
	# here rather than falling through to the SPA handler's
	# `try_files {path} /index.html` below.
	#
	# Without this, a chunk removed by a deploy answers with index.html and a
	# 200, so the browser parses HTML as JavaScript ("Failed to fetch
	# dynamically imported module") -- and because the `@assets` matcher there
	# matches the REQUEST path (*.js) whatever the body turned out to be, that
	# wrong response is stamped `immutable, max-age=31536000` and cached against
	# the chunk URL for a year. Every tab open across a release hits it, and no
	# amount of reloading clears it.
	handle /assets/* {
		root * /srv
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	# index.html for client-side routes. Framing + CSP belong to the HTML app
	# surface, so they are scoped here (not at the site level above).
	handle {
		header {
			X-Frame-Options "SAMEORIGIN"
			# connect-src is 'self' only: the shipped bundle's WebSocket is same-origin
			# (client.ts getWebSocketUrl falls back to window.location.host, and no
			# VITE_* build arg is passed in the prod build). If you BUILD with
			# VITE_WS_URL pointing elsewhere, add that origin here explicitly.
			Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; connect-src 'self'; font-src 'self'; object-src 'none'; frame-ancestors 'self'; base-uri 'self'; form-action 'self';"
		}
		root * /srv
		# Everything this handler serves is UNfingerprinted: index.html itself,
		# theme-init.js, locales, the manifest. It must revalidate every time.
		# Without this index.html carried no Cache-Control at all, so browsers
		# applied heuristic caching and kept a stale shell pointing at chunk
		# names a later release had deleted -- the app then could not load its
		# routes and a logged-in operator sat on the login page holding a valid
		# session cookie. The ETag makes revalidation a 304, not a download.
		#
		# The fingerprinted files are served by `handle /assets/*` above and
		# keep their year-long immutable caching. The old `@assets path *.js`
		# matcher lived here and, after that split, only matched the
		# UNfingerprinted root scripts -- pinning theme-init.js immutable for a
		# year so a change to it could never reach anyone.
		header Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}
}
