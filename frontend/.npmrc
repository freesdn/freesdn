# openapi-typescript@7.x still pins its peer at typescript@^5.x while this
# project tracks typescript@^6. The lockfile is resolved under legacy-peer-deps,
# so EVERY install path (npm ci in CI + the prod Docker builder, npm install in
# the dev Docker image, and local installs) must honor the same flag or `npm ci`
# fails ERESOLVE. Keeping it here - one source of truth - instead of scattering
# --legacy-peer-deps across CI steps and Dockerfiles.
# Drop this once openapi-typescript ships a TS6-compatible peer range.
legacy-peer-deps=true
