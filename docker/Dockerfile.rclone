# FreeSDN security rebuild; upstream runtime contract is preserved.
FROM golang:1.27.3-alpine3.24 AS builder
ENV CGO_ENABLED=0 GOTOOLCHAIN=local
WORKDIR /build
COPY rclone-build/go.mod rclone-build/go.sum ./
RUN go mod download all && go mod verify
RUN go build -mod=readonly -trimpath -ldflags="-s -w -X github.com/rclone/rclone/fs.Version=v1.75.1-freesdn" -o /out/service github.com/rclone/rclone

FROM rclone/rclone:1.75.1
RUN apk upgrade --no-cache
COPY --from=builder /out/service /usr/local/bin/rclone
COPY rclone-build/LICENSE rclone-build/NOTICE /usr/share/licenses/rclone/
