# FreeSDN - Valkey with current Alpine security patches.
# Keep the Debian runtime's UID/GID 999 so existing RDB/AOF volumes and
# explicitly configured --user values remain usable. GID 999 is otherwise the
# unused Alpine ping group. Valkey's persistence format is unchanged.
ARG VALKEY_VERSION=9.1.2-alpine
FROM valkey/valkey:${VALKEY_VERSION}

RUN if command -v apk >/dev/null 2>&1; then \
        apk upgrade --no-cache \
        && deluser valkey \
        && delgroup ping \
        && addgroup -S -g 999 valkey \
        && adduser -S -D -H -u 999 -G valkey valkey \
        && chown valkey:valkey /data; \
    else \
        apt-get update && apt-get upgrade -y \
        && rm -rf /var/lib/apt/lists/*; \
    fi
