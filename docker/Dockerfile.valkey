# FreeSDN - Valkey, OS layer patched at build time.
#
# A thin wrapper over the official valkey image. `apt-get upgrade` applies the
# latest Debian security updates (valkey's -trixie tag is Debian-based) so the
# RUNNING cache/broker ships with current patched packages regardless of base-tag
# rebuild lag. We no longer run the stock tag; we run this built, patched image.
#
# The version is an ARG so `VALKEY_VERSION` in the environment still selects the
# base, exactly as the old `image: valkey/valkey:${VALKEY_VERSION}` line did.
# User/Entrypoint/Cmd are inherited unchanged (base is User=[] root at build; the
# entrypoint drops to the valkey user at runtime) so behaviour matches stock.
ARG VALKEY_VERSION=8.1.9-trixie
FROM valkey/valkey:${VALKEY_VERSION}

RUN apt-get update && apt-get upgrade -y \
    && rm -rf /var/lib/apt/lists/*
