# FreeSDN PostgreSQL 18 runtime, on Debian (glibc), matching published 26.09.0.
#
# This deliberately stays on Debian. The Alpine move was made to satisfy an
# image-CVE gate configured with ignore-unfixed=false, under which a Debian base
# can never pass: measured with Trivy at HIGH,CRITICAL, postgres:18.6-trixie
# reports 84 findings and postgres:18.6-alpine3.24 reports 22 -- but their
# FIXABLE counts are IDENTICAL at 22 each. The entire gap is CVEs Debian's
# tracker acknowledges and has not patched, which Alpine's tracker does not
# carry. The move reduced a scanner number, not the patchable attack surface,
# and it cost an in-place upgrade: musl instead of glibc, the locale provider
# forced to builtin C.UTF-8 (which PostgreSQL documents as able to change text
# sorting, case conversion and expression/unique index behaviour), and the
# postgres UID moving 999 -> 70 so the old volume could not even be reused.
#
# For a database that is the wrong trade. Debian is also where PostgreSQL's own
# official images and upstream attention live.
ARG POSTGRES_VERSION=18.6-trixie
FROM golang:1.27.3-alpine3.24 AS gosu-builder
ENV CGO_ENABLED=0 GOTOOLCHAIN=local
WORKDIR /build
COPY gosu-build/go.mod gosu-build/go.sum ./
RUN go mod download all && go mod verify
RUN go build -mod=readonly -trimpath -ldflags="-s -w" -o /out/gosu github.com/tianon/gosu

FROM postgres:${POSTGRES_VERSION}
COPY --from=gosu-builder /out/gosu /usr/local/bin/gosu
COPY gosu-build/LICENSE gosu-build/NOTICE /usr/share/licenses/gosu/
# This image also supplies the encrypted pg-backup client. Keep GPG working;
# changing the server base must not silently disable encrypted backups.
RUN . /etc/os-release && test "$VERSION_CODENAME" = trixie \
    && test "$PG_MAJOR" = 18 \
    && apt-get update \
    && apt-get upgrade -y --no-install-recommends \
    && apt-get install -y --no-install-recommends gnupg \
    && rm -rf /var/lib/apt/lists/* \
    && gosu nobody true \
    && mv /usr/local/bin/docker-entrypoint.sh /usr/local/bin/docker-entrypoint-upstream.sh \
    && printf '%s\n' 'postgresql-18-debian-trixie-v1' > /usr/local/share/freesdn-database-runtime \
    && printf "\ninclude_if_exists = '/etc/postgresql/conf.d/custom.conf'\n" \
       >> /usr/share/postgresql/postgresql.conf.sample
# Data checksums only. The locale provider is left at the Debian default on
# purpose: forcing builtin C.UTF-8 is what made 26.09.0 clusters unadoptable.
ENV POSTGRES_INITDB_ARGS="--data-checksums"
COPY --chmod=755 postgres/runtime-entrypoint.sh /usr/local/bin/docker-entrypoint.sh
COPY --chmod=644 postgres/zz-freesdn-runtime.sh /docker-entrypoint-initdb.d/zz-freesdn-runtime.sh
