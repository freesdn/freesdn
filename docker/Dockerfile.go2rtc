# FreeSDN security rebuild; upstream runtime contract is preserved.
FROM golang:1.27.3-alpine3.24 AS builder
ENV CGO_ENABLED=0 GOTOOLCHAIN=local
WORKDIR /build
COPY go2rtc-build/go.mod go2rtc-build/go.sum ./
RUN go mod download all && go mod verify
RUN go build -mod=readonly -trimpath -ldflags="-s -w" -o /out/service github.com/AlexxIT/go2rtc

# Use the same verified stable media recipe as the backend build context.
FROM alpine:3.24 AS ffmpeg-builder
WORKDIR /build
COPY ffmpeg-build/ ./
RUN sh /build/build.sh

# Recreate the upstream runtime toolset on a patched, supported Python/Alpine
# base. No package installation is needed by go2rtc at runtime; operators with
# custom Python exec sources should bake their dependencies into a derived image.
FROM python:3.14.8-alpine3.24
# Exact upstream security backports; unknown Python source fails the build.
COPY python-security/ /usr/local/share/freesdn/python-security/
RUN python -B /usr/local/share/freesdn/python-security/apply_backports.py \
    && python -B /usr/local/share/freesdn/python-security/apply_backports.py --verify
ARG TARGETARCH
RUN apk upgrade --no-cache \
    && apk add --no-cache tini bash curl jq alsa-plugins-pulse font-droid \
    && if [ "$TARGETARCH" = "amd64" ]; then apk add --no-cache libva-intel-driver intel-media-driver; fi \
    && python -m pip uninstall -y pip \
    && rm -rf /usr/local/lib/python3.14/ensurepip
COPY --from=builder /out/service /usr/local/bin/go2rtc
COPY --from=ffmpeg-builder /out/ /
RUN sh /usr/share/freesdn-sources/ffmpeg/install-runtime.sh
COPY go2rtc-build/LICENSE go2rtc-build/NOTICE /usr/share/licenses/go2rtc/
EXPOSE 1984/tcp 8554/tcp 8555/tcp 8555/udp
VOLUME ["/config"]
WORKDIR /config
ENTRYPOINT ["/sbin/tini", "--"]
CMD ["go2rtc", "-config", "/config/go2rtc.yaml"]
