# ============================================================
# FreeSDN - Environment Configuration
# ============================================================
# Copy to .env and fill in real, random values before first run.
# NEVER commit .env to version control.
#
# Variables marked [REQUIRED] must be set for production.
# All others have sensible defaults for development.
# ============================================================

# ── Application ─────────────────────────────────────────────
ENVIRONMENT=development          # development | staging | production
# DEBUG=false
# LOG_LEVEL=INFO                 # DEBUG | INFO | WARNING | ERROR
# LOG_FORMAT=json                # json | text

# ── Security [REQUIRED in production] ───────────────────────
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=CHANGE_ME_generate_a_64_char_random_string
ENCRYPTION_SALT=CHANGE_ME_generate_a_unique_salt
# ALLOW_REGISTRATION=false       # Set true to allow self-registration

# ── PostgreSQL (primary) ────────────────────────────────────
POSTGRES_USER=freesdn
POSTGRES_PASSWORD=CHANGE_ME_postgres_strong_password
POSTGRES_DB=freesdn
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432
# Or provide a full URL (overrides individual fields):
# DATABASE_URL=postgresql+asyncpg://freesdn:password@localhost:5432/freesdn

# Connection pool (tuned for 1000+ devices)
# DB_POOL_SIZE=20
# DB_MAX_OVERFLOW=30
# DB_POOL_TIMEOUT=30

# ── TimescaleDB (LogDB - time-series data) ─────────────────
# REQUIRED: Separate TimescaleDB instance for metrics, health checks,
# heartbeats, and events.  LogDB is mandatory - the application will
# refuse to start in production/staging without LOGDB_URL.
# Automatically configured via docker-compose; no manual LOGDB_URL needed.
LOGDB_USER=freesdn
LOGDB_PASSWORD=CHANGE_ME_logdb_strong_password
LOGDB_DB=freesdn_logs

# LogDB connection pool (tune for high-frequency writes)
# LOGDB_POOL_SIZE=10
# LOGDB_MAX_OVERFLOW=15

# ── Redis ───────────────────────────────────────────────────
REDIS_PASSWORD=CHANGE_ME_redis_strong_password
# REDIS_HOST=localhost
# REDIS_PORT=6379
# REDIS_DB=0
# Or provide a full URL:
# REDIS_URL=redis://localhost:6379/0

# ── Celery (defaults to Redis URL) ─────────────────────────
# CELERY_BROKER_URL=redis://localhost:6379/0
# CELERY_RESULT_BACKEND=redis://localhost:6379/0

# ── Flower (Celery dashboard) ──────────────────────────────
FLOWER_BASIC_AUTH=admin:CHANGE_ME_flower_password

# ── JWT Tokens ─────────────────────────────────────────────
# ACCESS_TOKEN_EXPIRE_MINUTES=60
# REFRESH_TOKEN_EXPIRE_DAYS=14
# "Remember me" at login extends the refresh window to this many days:
# REMEMBER_ME_REFRESH_TOKEN_EXPIRE_DAYS=30

# ── Password Policy ───────────────────────────────────────
# PASSWORD_MIN_LENGTH=12
# PASSWORD_REQUIRE_UPPERCASE=true
# PASSWORD_REQUIRE_LOWERCASE=true
# PASSWORD_REQUIRE_DIGIT=true
# PASSWORD_REQUIRE_SPECIAL=true

# ── Rate Limiting ──────────────────────────────────────────
# RATE_LIMIT_ENABLED=true
# RATE_LIMIT_DEFAULT=100/minute
# RATE_LIMIT_AUTH=5/minute
# Global per-principal request limit (RateLimitMiddleware). Bucket is keyed
# per authenticated user when an access cookie is present, else by client IP.
# Defaults are generous so a busy SPA / many users behind one NAT egress IP
# aren't 429'd. Lower these in production to throttle a single principal.
# RATE_LIMIT_RPM=600
# RATE_LIMIT_BURST=120

# ── Feature Flags ──────────────────────────────────────────
# Device write mode. FreeSDN MANAGES your gear: by default it can stage and apply
# configuration changes to connected controllers/firewalls/etc. (behind login +
# RBAC; destructive actions need an extra confirmation) - the same as OPNsense,
# pfSense, Omada or UniFi once you're signed in. To evaluate FreeSDN in
# MONITOR-ONLY mode first - it reads and shows everything but never writes to a
# device - set this to true, then flip it back to false when you're ready to manage.
# ADAPTER_READ_ONLY=false
#
# When ENABLE_METRICS=true (default), a Prometheus exposition endpoint is
# served at GET /metrics on the API port. Scrape config for Prometheus:
#
#   scrape_configs:
#     - job_name: freesdn
#       scrape_interval: 30s
#       static_configs:
#         - targets: ['freesdn-api:8000']
#
# A sample Grafana dashboard lives at observability/grafana/freesdn-overview.json.
# ENABLE_METRICS=true
#
# When METRICS_AUTH_TOKEN is set, /metrics requires an
#   Authorization: Bearer <this-token>
# header. Configure Prometheus with a bearer_token_file pointing at the same
# secret. Leave empty for local/dev (metrics exposed without auth - leaks
# labels like version, route inventory, and in-progress counters to anyone
# who can reach the port). Generate with: openssl rand -hex 32
# METRICS_AUTH_TOKEN=
# ENABLE_DOCS=true               # Swagger UI at /docs
# ENABLE_PROFILING=false

# ── API ────────────────────────────────────────────────────
# API_V1_PREFIX=/api/v1
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://127.0.0.1:5173"]

# Public base URL - the externally-reachable URL for this FreeSDN instance.
# Used to build agent WebSocket URLs and other external-facing links.
# In production, set to your real domain (e.g., https://freesdn.example.com).
# PUBLIC_BASE_URL=http://localhost:8000

# ── Frontend ───────────────────────────────────────────────
# VITE_API_URL is the browser-side API base (used by Axios).
# The Vite dev server proxies /api/* to VITE_PROXY_TARGET (set in docker-compose).
VITE_API_URL=http://localhost:8000
VITE_WS_URL=ws://localhost:8000/api/v1/ws

# ── Host Port Overrides (optional) ─────────────────────────
# selfheal.py auto-resolves conflicts and writes these for you.
# API_HOST_PORT=8000
# FRONTEND_HOST_PORT=5173
# FLOWER_HOST_PORT=5555
# POSTGRES_HOST_PORT=15432
# LOGDB_HOST_PORT=15433
# REDIS_HOST_PORT=16379

# ── Resource Limits ─────────────────────────────────────────
# Configure per-container memory and CPU limits for your hardware.
# Defaults are tuned for a 16GB / 4-core machine.
# Small machine (8GB / 2-core): halve the memory, set CPUs to 1.0 max.
# Large machine (32GB+ / 8-core+): double the memory, raise CPUs.
#
# POSTGRES_MEM_LIMIT=2G
# POSTGRES_CPU_LIMIT=2.0
# POSTGRES_MEM_RESERVATION=512M
#
# LOGDB_MEM_LIMIT=2G
# LOGDB_CPU_LIMIT=2.0
# LOGDB_MEM_RESERVATION=512M
#
# REDIS_MEM_LIMIT=768M
# REDIS_CPU_LIMIT=1.0
# REDIS_MEM_RESERVATION=256M
#
# API_MEM_LIMIT=1G
# API_CPU_LIMIT=2.0
# API_MEM_RESERVATION=256M
#
# WORKER_MEM_LIMIT=1G
# WORKER_CPU_LIMIT=2.0
# WORKER_MEM_RESERVATION=256M
#
# SCHEDULER_MEM_LIMIT=512M
# SCHEDULER_CPU_LIMIT=0.5
# SCHEDULER_MEM_RESERVATION=128M
#
# FLOWER_MEM_LIMIT=512M
# FLOWER_CPU_LIMIT=0.5
# FLOWER_MEM_RESERVATION=128M
#
# FRONTEND_MEM_LIMIT=512M
# FRONTEND_CPU_LIMIT=1.0
# FRONTEND_MEM_RESERVATION=128M
#
# Production-only containers:
# BACKUP_MEM_LIMIT=512M
# BACKUP_CPU_LIMIT=0.5
# BACKUP_MEM_RESERVATION=128M
#
# CERTBOT_MEM_LIMIT=256M
# CERTBOT_CPU_LIMIT=0.25

# ── Gunicorn / API Server Tuning ───────────────────────────
# Controls how the backend API scales to the host hardware.
# WEB_CONCURRENCY: number of gunicorn worker processes.
#   Rule of thumb: (2 × CPU cores) + 1.  Default 2 for small controllers.
# WEB_CONCURRENCY=2
# GUNICORN_MAX_REQUESTS=1000     # Recycle workers after N requests (memory leak protection)
# GUNICORN_MAX_REQUESTS_JITTER=50
# GUNICORN_GRACEFUL_TIMEOUT=30   # Seconds to finish in-flight requests on shutdown
# GUNICORN_TIMEOUT=120           # Worker timeout for slow requests
# GUNICORN_KEEP_ALIVE=5          # Keep-alive seconds
# API_STOP_GRACE_PERIOD=40s      # Docker stop grace period for API container

# ── Celery Worker Tuning ───────────────────────────────────
# Controls background task processing capacity.
# CELERY_POOL=solo               # solo | prefork | gevent (solo is safest default)
# CELERY_CONCURRENCY=1           # Number of concurrent task workers
# CELERY_MAX_TASKS_PER_CHILD=1000  # Recycle workers after N tasks (memory protection)
# WORKER_STOP_GRACE_PERIOD=60s   # Time for worker to finish current task before kill

# ── PgBouncer (connection pooling) ─────────────────────────
# PgBouncer is OPTIONAL. By default, services connect directly to PostgreSQL.
# For small deployments (≤50 devices), PgBouncer is unnecessary overhead.
# For larger deployments (50+ devices, multiple API workers), enable PgBouncer:
#
#   1. Set these env vars:
#      DB_HOST=pgbouncer
#      DB_PORT=6432
#      LOGDB_HOST=pgbouncer-logdb
#      LOGDB_PORT=6432
#
#   2. Start with the pgbouncer profile:
#      docker compose --profile pgbouncer up -d
#      docker compose -f docker-compose.prod.yml --profile pgbouncer up -d
#
# Without these settings, API/worker/scheduler connect directly to postgres:5432.
# DB_HOST=postgres              # Default: direct connection (no pgbouncer)
# DB_PORT=5432
# LOGDB_HOST=logdb
# LOGDB_PORT=5432
#
# Pool tuning (edit docker/pgbouncer/*.ini for pool modes):
# PGBOUNCER_MEM_LIMIT=256M
# PGBOUNCER_CPU_LIMIT=0.5
# PGBOUNCER_LOGDB_MEM_LIMIT=256M
# PGBOUNCER_LOGDB_CPU_LIMIT=0.5

# ── PostgreSQL / TimescaleDB / Redis Tuning ────────────────
# Application-level tuning uses config files (standard pattern).
# Edit these files to tune for your hardware - all settings are
# commented out by default and services use built-in defaults:
#   docker/postgres/custom.conf       - PostgreSQL primary database
#   docker/postgres/logdb-custom.conf - TimescaleDB (LogDB)
#   docker/redis/redis-custom.conf    - Redis cache / broker

# ── Cameras: live video + push ─────────────────────────────
# go2rtc restream sidecar (live MSE/WebRTC). Auto-wired by docker-compose.
# GO2RTC_URL=http://go2rtc:1984
#
# WebPush (browser push for camera alerts) - OPTIONAL. Leave blank to disable.
# Generate a VAPID keypair once:  vapid --gen   (from the py-vapid CLI)
# Requires HTTPS in production (push is blocked on insecure origins).
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:admin@your-domain.example

# ── Production / SSL ───────────────────────────────────────
# SSL_MODE=off                   # off | self-signed | letsencrypt
# DOMAIN=localhost
# LETSENCRYPT_EMAIL=
# FRONTEND_HTTP_PORT=80
# FRONTEND_HTTPS_PORT=443

# ==============================================================================
# Reverse Proxy Configuration (SECURITY - P0)
# ==============================================================================
# Gunicorn only trusts X-Forwarded-* headers when the request arrives from one
# of these IPs / CIDR blocks. If an untrusted source sends X-Forwarded-For,
# uvicorn will NOT rewrite request.client.host, which protects the per-IP
# rate limiter (backend/app/api/v1/endpoints/auth.py) and the audit log from
# header-spoofing attacks (e.g. credential-stuffing bypass).
#
# SAFE DEFAULTS:
#   - 127.0.0.1            - nginx sidecar on the same host (standalone image)
#   - 172.28.0.0/16        - freesdn docker-compose bridge network (default
#                            subnet pinned in docker-compose.prod.yml)
#
# For docker-compose deployments the compose file sets this automatically to
# the pinned NETWORK_SUBNET. Only override if you changed NETWORK_SUBNET or
# put a load balancer in front of the api container directly.
#
# WARNING: NEVER set this to "*" in production. A wildcard tells gunicorn
# to trust X-Forwarded-For from ANY source, which lets an attacker who can
# reach the container directly (e.g. another container, a sidecar, a host
# with the API port exposed) forge arbitrary client IPs and bypass the
# per-IP rate limiter on /auth/login, /auth/login/mfa, /auth/register, and
# /auth/password-reset - enabling unlimited credential stuffing.
#
# The backend entrypoint refuses to start if FORWARDED_ALLOW_IPS="*".
# FORWARDED_ALLOW_IPS=127.0.0.1

# Pinned CIDR for the docker-compose bridge network. Kept in sync with
# FORWARDED_ALLOW_IPS above so the api container trusts X-Forwarded-* from
# exactly the nginx sidecar and nothing else. Change only if the default
# collides with another network on your host.
# NETWORK_SUBNET=172.28.0.0/16

# ==============================================================================
# Backups (pg-backup container)
# ==============================================================================
# The pg-backup container in docker-compose.prod.yml runs pg_dump on a 24h
# cycle and writes the output to the ``pg_backups`` named volume. In dev
# compose the cycle is 12h with 3-day retention; in prod the cycle is 24h
# with 7-day retention.
#
# ENCRYPTION (GPG public-key, asymmetric)
# ----------------------------------------
# By design the pg-backup container can ENCRYPT but never DECRYPT - the
# matching private key MUST live on a separate secured host. Restore is
# performed there with ``gpg --decrypt`` (see
# https://docs.freesdn.org/deploy/backups-and-restore/).
#
# Setup:
#   1. On the secured restore host:
#        gpg --quick-generate-key 'FreeSDN Backup <backup@example.com>' rsa4096 default 1y
#   2. Export the public half and copy it to this host:
#        gpg --armor --export backup@example.com > secrets/backup-public.asc
#   3. Set the two variables below.
#
# If BACKUP_GPG_RECIPIENT is empty (default), the container falls back to
# writing UNENCRYPTED .sql.gz dumps with a startup log line. That is fine
# for dev but NOT supported for production.
# BACKUP_GPG_RECIPIENT=backup@example.com
# BACKUP_GPG_PUBLIC_KEY_PATH=./secrets/backup-public.asc

# OFF-SITE REPLICATION (opt-in via ``--profile offsite``)
# --------------------------------------------------------
# The pg-backup-offsite sidecar uses rclone to copy the encrypted dumps
# off the host to operator-configured remote storage. rclone supports
# 60+ providers: S3 (AWS / Wasabi / B2-compatible / MinIO), Azure Blob,
# GCS, Backblaze B2, SFTP, WebDAV, Google Drive, OneDrive, and more.
#
# Setup:
#   1. Generate an rclone config (anywhere - it's just a text file):
#        rclone config  →  name your remote (e.g. "backupremote")
#   2. Save the resulting rclone.conf to ./secrets/rclone.conf
#   3. Set the variables below
#   4. Start the sidecar:
#        docker compose -f docker-compose.prod.yml --profile offsite up -d
#
# Off-site retention is INDEPENDENT of local retention - pruning a local
# backup does NOT prune the off-site copy (industry standard pattern,
# matches pfSense ACB / UniFi Cloud Backup / TrueNAS replication).
# BACKUP_OFFSITE_REMOTE=backupremote        # rclone remote name from rclone.conf
# BACKUP_OFFSITE_PATH=freesdn-backups       # path on remote (bucket / dir)
# BACKUP_OFFSITE_INTERVAL_HOURS=24          # cycle (default 24h)
# BACKUP_OFFSITE_RETENTION_DAYS=30          # off-site retention (default 30d)
# BACKUP_OFFSITE_CONFIG_PATH=./secrets/rclone.conf

# ── Production Checklist ──────────────────────────────────
# Before deploying to production, ensure ALL of the following:
#   1. ENVIRONMENT=production
#   2. SECRET_KEY - random ≥64 chars (python -c "import secrets; print(secrets.token_urlsafe(64))")
#   3. ENCRYPTION_SALT - random ≥32 chars (python -c "import secrets; print(secrets.token_urlsafe(32))")
#   4. POSTGRES_PASSWORD - strong random password (≥32 chars)
#   5. LOGDB_PASSWORD - strong random password (≥32 chars)
#   6. REDIS_PASSWORD - strong random password (≥32 chars)
#   7. FLOWER_BASIC_AUTH - admin:<strong_password>
#   8. CORS_ORIGINS - your production domain(s), e.g. ["https://nms.example.com"]
#      localhost origins are automatically stripped in production.
#   9. SSL_MODE - self-signed or letsencrypt (never off in production)
#  10. DOMAIN - your actual domain (e.g. nms.example.com)
#  11. ALLOW_REGISTRATION=false (default, keep it)
#
# The backend will REFUSE to start in production if SECRET_KEY,
# ENCRYPTION_SALT, or POSTGRES_PASSWORD are insecure/default values.
